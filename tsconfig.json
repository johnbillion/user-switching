{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"lib": ["ES2023"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"moduleResolution": "NodeNext",
		"types": ["@playwright/test", "node"]
	},
	"include": ["tests/**/*.ts"],
	"exclude": ["node_modules"]
}
